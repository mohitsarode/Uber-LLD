# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development

# Spatial Indexing (Uber H3)
H3_DEFAULT_RESOLUTION=8
H3_DISPATCH_MAX_KRING=3
H3_REGIONAL_RESOLUTION=6

# Redis Mesh Configuration
# For local dev without external Redis, set USE_FAKEREDIS=true
REDIS_URL=redis://localhost:6379/0
USE_FAKEREDIS=false

# Database Configuration (PostgreSQL / TimescaleDB)
# For local zero-dependency testing, set USE_SQLITE=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hexdispatch
USE_SQLITE=true
SQLITE_DB_PATH=./hexdispatch.db

# Telemetry Ingestion Buffer
TELEMETRY_BUFFER_BATCH_SIZE=50
TELEMETRY_BUFFER_FLUSH_INTERVAL_SEC=1.0

# Dispatch Engine Parameters
DRIVER_HEARTBEAT_TIMEOUT_SEC=30
DISPATCH_OFFER_TTL_SEC=12
DISPATCH_SEARCH_TIMEOUT_SEC=5.0
WEIGHT_DISTANCE=0.60
WEIGHT_RATING=0.25
WEIGHT_BEARING=0.15
